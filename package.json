{
  "name": "portfolio-next-repo-root",
  "private": true,
  "description": "Monorepo root. The Next.js app is in Portfolio_NEXT/. Vercel uses vercel.json to build there.",
  "dependencies": {
    "next": "14.2.7",
    "react": "^18",
    "react-dom": "^18"
  },
  "scripts": {
    "build": "cd Portfolio_NEXT && npm run build",
    "dev": "cd Portfolio_NEXT && npm run dev",
    "lint": "cd Portfolio_NEXT && npm run lint",
    "start": "cd Portfolio_NEXT && npm run start",
    "postinstall": "cd Portfolio_NEXT && npm install"
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
"scripts": {
  "dev": "next dev --webpack",
  "build": "next build --webpack",
  "start": "next start"
},
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "16.2.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.3.0",
    "react-toastify": "^10.0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
